# Stage 1: Build React frontend
FROM node:22-alpine AS react-build
WORKDIR /react
COPY react/package.json react/package-lock.json ./
RUN npm install --include=dev
COPY react/ .
RUN npm run build

# Stage 2: Build Django backend
FROM python:3.13-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY django/pyproject.toml django/uv.lock ./
RUN pip install uv && uv sync --frozen

COPY django/ .
COPY --from=react-build /django/static-vite /app/static-vite

COPY django/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8000

ENV DJANGO_SETTINGS_MODULE=demschooltools.settings_ci
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/docker-entrypoint.sh"]
