# DemSchoolTools Environment Variables
# Copy this file to .env and fill in the values.

# Required: Shared secret for PLAY_SESSION JWT signing (must match Play Framework config)
APPLICATION_SECRET=changeme

# Required (production): Django secret key
DJANGO_SECRET_KEY=changeme

# Database (defaults in settings.py: school_crm, postgres, 123)
# DST_DB_NAME=school_crm
# DST_DB_USER=postgres
# DST_DB_PASSWORD=123
# DST_DB_HOST=localhost

# Rollbar error tracking (optional)
# ROLLBAR_TOKEN=
# ROLLBAR_FRONTEND_TOKEN=
